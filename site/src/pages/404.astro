---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { smartQuotes } from "../lib/text";
---

<Base
  title="Not found — Jesse McGinnis"
  description="This page is not here."
  canonicalPath={null}
  noindex
>
  <Header />
  <main id="main" class="not-found">
    <p class="kicker">404</p>
    <h1>{smartQuotes("This page isn't here.")}</h1>
    <p class="deck">
      {smartQuotes("The link may be old, or the page may have moved.")}
    </p>
    <p>
      <a href="/">Go home →</a>
    </p>
  </main>
  <Footer />
</Base>

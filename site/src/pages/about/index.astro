---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { careerPath } from "../../lib/career";
---

<Base
  title="About — Jesse McGinnis"
  description="The longer story: the career path behind the writing."
  canonicalPath="/about/"
>
  <Header active="About" />
  <main class="about" id="main">
    <div class="about-grid">
      <nav class="about-rail" aria-label="The path">
        {careerPath.map((era) => (
          <a class="about-era" href={`#era-${era.id}`}>
            <span class="label">{era.years}</span>
            <span class="about-company">{era.company}</span>
          </a>
        ))}
      </nav>

      <div class="about-main">
        <p class="kicker">About</p>
        <h1>The path</h1>
        <p class="deck">
          The longer story. What I learned, where, and what I'm still learning.
        </p>

        {careerPath.map((era) => (
          <section class="about-section" id={`era-${era.id}`}>
            <div class="about-section-head">
              <p class="label">
                {era.years}
                {era.title !== era.company && ` · ${era.company}`}
              </p>
              <h2>{era.title}</h2>
            </div>
            {era.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {era.chapters.map((chapter) => (
              <section class="about-chapter">
                <p class="label">{chapter.years}</p>
                <h3>{chapter.name}</h3>
                {chapter.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </section>
            ))}
          </section>
        ))}

        <p class="signoff">— J.</p>
        <p class="colophon">
          <a href="/">Back to the front page →</a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
  <script>
    const rail = document.querySelector(".about-rail");
    const sections = Array.from(
      document.querySelectorAll(".about-section"),
    ).filter((section) => section.id) as HTMLElement[];

    if (rail && sections.length && "IntersectionObserver" in window) {
      const links = new Map<string, HTMLAnchorElement>();
      rail.querySelectorAll<HTMLAnchorElement>(".about-era").forEach((link) => {
        const id = link.getAttribute("href")?.slice(1);
        if (id) links.set(id, link);
      });

      const visible = new Set<string>();
      let active: string | null = null;

      const mark = (id: string | undefined) => {
        if (!id || id === active) return;
        active = id;
        links.forEach((link, key) => {
          if (key === id) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          }
          const current = sections.find((section) => visible.has(section.id));
          mark(current?.id);
        },
        { rootMargin: "-120px 0px -60% 0px" },
      );

      sections.forEach((section) => observer.observe(section));
    }
  </script>
</Base>

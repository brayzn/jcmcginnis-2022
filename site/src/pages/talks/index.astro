---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import {
  featuredTalk,
  talkKind,
  talkPath,
  talkResources,
  talkYears,
  talksByYear,
} from "../../lib/talks";

const talks = await getCollection("talks");
const featured = featuredTalk(talks);
const years = talkYears(talks);
const firstYear = years.at(-1);
const lastYear = years[0];
---

<Base
  title="Speaking — Jesse McGinnis"
  description="Talks and workshops on high-trust teams, leadership, and the structures that help people do good work."
  canonicalPath="/talks/"
>
  <Header />
  <main class="talks" id="main">
    <p class="kicker">
      Speaking · {firstYear}–{lastYear}
    </p>
    <h1 class="page-title">Talks & workshops.</h1>
    <p class="deck">
      A decade of building teams. No frameworks for frameworks' sake. Just what
      works.
    </p>

    <section class="talk-featured">
      <div class="section-head">
        <h2>Featured</h2>
        <span>Watch the talk</span>
      </div>
      <ul class="selected-large">
        <li>
          <a href={talkPath(featured)}>{featured.data.title}</a>
          <span>
            {featured.data.year} · {talkKind(featured)}
          </span>
          <p>{featured.data.event}</p>
          {talkResources(featured).length > 0 && (
            <p class="talk-resources">
              {talkResources(featured).map((link, index) => (
                <>
                  {index > 0 && " · "}
                  <a href={link.href}>{link.label}</a>
                </>
              ))}
            </p>
          )}
        </li>
      </ul>
    </section>

    <div class="talk-years">
      {years.map((year) => (
        <section class="talk-group">
          <h2>{year}</h2>
          <ul class="talk-list">
            {talksByYear(talks, year).map((talk) => (
              <li>
                <span class="talk-kind">{talkKind(talk)}</span>
                <div class="talk-body">
                  <a href={talkPath(talk)}>{talk.data.title}</a>
                  {talk.data.featured && (
                    <span class="talk-badge">Featured</span>
                  )}
                  <p>{talk.data.event}</p>
                </div>
                <span class="talk-resources">
                  {talkResources(talk).length > 0
                    ? talkResources(talk).map((link, index) => (
                        <>
                          {index > 0 && " · "}
                          <a href={link.href}>{link.label}</a>
                        </>
                      ))
                    : ""}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Base>

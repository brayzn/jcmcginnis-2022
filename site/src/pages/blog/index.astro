---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { archiveEntries, archiveYears, entriesByYear } from "../../lib/archive";

const essays = await getCollection("essays");
const entries = archiveEntries(essays);
const years = archiveYears(entries);
const firstYear = years.at(-1);
const lastYear = years[0];
---

<Base
  title="All writing, newest first — Jesse McGinnis"
  description="Every essay in the order it was published, newest first."
  canonicalPath="/blog/"
>
  <Header active="Writing" />
  <main class="archive" id="main">
    <p class="kicker">
      Writing · {firstYear}–{lastYear}
    </p>
    <h1>All writing, newest first.</h1>
    <p class="deck">
      Every essay in the order it was published. The selected index lives in the
      archive.
    </p>

    <section class="blog-years">
      {years.map((year) => (
        <div class="index-group">
          <h2>{year}</h2>
          <ul>
            {entriesByYear(entries, year).map((entry) => (
              <li>
                <span>{entry.dateLabel}</span>
                <a href={entry.href}>{entry.title}</a>
                {entry.historyHref && entry.revisionStamp && (
                  <a
                    class="revised"
                    href={entry.historyHref}
                    aria-label={`Revision history for ${entry.title}`}
                  >
                    {entry.revisionStamp}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <p class="feed-cta">
      New essays, delivered. RSS. Your reader. No algorithms.
      <a href="/feed.xml">Subscribe via RSS →</a>
    </p>

    <p class="index-link">
      <a href="/archive/">Selected index →</a>
    </p>
  </main>
  <Footer />
</Base>
